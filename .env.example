# 复制成 .env 再填值。.env 已被 .gitignore 忽略，**绝不要把真 key 提交进仓库**。
# 全部变量都有默认值或可缺省，只有 LLM key 是必须的。

# ── LLM（必须，二选一）─────────────────────────────
# 默认 provider 是 deepseek。任何 OpenAI 兼容端点都能接。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 换 provider / 模型（可选）
# CCB_LLM_PROVIDER=deepseek            # deepseek | openai
# OPENAI_BASE_URL=                     # 自建兼容端点时填

# ── 库位置（可选）──────────────────────────────────
# 数据层与决策层**必须指向同一个库**，否则 Agent 永远看不到新闻。
# 默认 ccb-sub-agents/ccb_subagents.db
# CCB_DB_PATH=C:\path\to\ccb_subagents.db

# ── 数据层（全部可选）──────────────────────────────
# 采集清单。不设时自动取各 agents/*.json 里 universe 的并集（推荐留空）。
# CCB_WATCHLIST=BTC-USD,ETH-USD,AAPL,^GSPC

# 宏观序列走 FRED，没有 key 时会跳过这个源（不影响其它源）。
# FRED_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 预测市场的搜索关键词。
# CCB_PREDICTION_TOPICS=Fed rate cut,recession 2026,bitcoin 2026

# FRED 序列别名（见 info_feeds/vendors/fred.py 的 MACRO_SERIES）。
# CCB_MACRO_SERIES=fed_funds_rate,cpi,unemployment_rate,10y_treasury

# 个股新闻回溯天数。
# CCB_NEWS_LOOKBACK_DAYS=3

# 只有要跑 Alpha Vantage / SEC EDGAR 的 vendor 才需要。
# ALPHA_VANTAGE_API_KEY=xxxxxxxxxxxxxxxx
# SEC_EDGAR_USER_AGENT=Your Name your@email.com
